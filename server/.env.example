# SQLite by default: no database install needed. The file is created at server/prisma/dev.db
DATABASE_URL="file:./dev.db"
PORT=4000
# Comma-separated list of allowed browser origins (only needed if you don't use the Vite proxy)
CLIENT_ORIGIN="http://localhost:5173"
# Generated automatically by npm install / npm run db:setup. Used to log in at /#admin
ADMIN_TOKEN="change-me-to-a-long-random-string"
